generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Single settings row (id = 1). Money is always integer cents.
model Settings {
  id                   Int      @id @default(1)
  startingBalanceCents Int      @default(-130000)
  startDate            DateTime @default(now())
  businessCutPercent   Float    @default(10)
  partnerAName         String   @default("Ahmad")
  partnerBName         String   @default("Mo")
  /// Partner A's share of splittable profit in percent (B gets 100 - this)
  partnerARatio        Float    @default(50)
  /// "profit" | "seller" | "business"
  tipHandling          String   @default("profit")
  /// "A" | "B"
  defaultSoldBy        String   @default("A")
  lowStockThreshold    Int      @default(3)
  /// JSON array of payment method names offered at checkout, in display order
  paymentMethods       String   @default("[\"Cash\",\"Zelle\",\"Cash App\",\"Venmo\",\"Apple Pay\",\"Other\"]")
  passwordHash         String?
  /// JSON: store settings (open/closed, payments, shipping, emails...). See src/lib/store/config.ts
  storeJson            String   @default("{}")
  /// JSON: everything editable on the storefront (hero, sections, FAQ, policies, SEO)
  contentJson          String   @default("{}")
  /// JSON { discounts: [{ type, value }], tips: [cents] }: quick buttons in the Sell cart. Empty = defaults.
  sellButtonsJson      String   @default("")
  updatedAt            DateTime @updatedAt
}

/// Parent product shown on the website. Its variants are Product rows (one per size).
model Listing {
  id              String    @id
  name            String
  /// Unique in practice (enforced by the app when saving)
  slug            String    @default("")
  summary         String    @default("")
  description     String    @default("")
  casNumber       String    @default("")
  formula         String    @default("")
  molecularWeight String    @default("")
  purity          String    @default("")
  form            String    @default("")
  storage         String    @default("")
  showOnWebsite   Boolean   @default(false)
  /// JSON array of { id, file, alt }
  photosJson      String    @default("[]")
  hoverGif        String    @default("")
  /// JSON array of ProductGroup ids
  groupsJson      String    @default("[]")
  /// JSON array of badge texts
  badgesJson      String    @default("[]")
  /// Manual best seller pick (used when best sellers are set to manual)
  bestSeller      Boolean   @default(false)
  /// JSON array of { minQty, percentOff }: "buy more, save more" tiers. Empty string = use the store default.
  qtyDealsJson    String    @default("")
  sortOrder       Int       @default(0)
  seoTitle        String    @default("")
  seoDescription  String    @default("")
  createdAt       DateTime  @default(now())
  variants        Product[]
}

model ProductGroup {
  id        String   @id
  name      String
  slug      String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

/// A variant: the thing that has stock, cost, price and sales history.
model Product {
  id                String            @id
  name              String
  defaultPriceCents Int               @default(0)
  /// Manual override for cost per unit. Null = weighted average of purchases.
  costOverrideCents Int?
  lowStockThreshold Int?
  color             String            @default("slate")
  sortOrder         Int               @default(0)
  archived          Boolean           @default(false)
  createdAt         DateTime          @default(now())
  /// Parent product. The app creates one when missing.
  listingId         String?
  listing           Listing?          @relation(fields: [listingId], references: [id], onDelete: SetNull)
  /// Size label shown on the website, e.g. "10mg"
  variantLabel      String            @default("")
  /// Optional vial volume shown with the size, e.g. "3ml"
  vialVolume        String            @default("")
  variantSort       Int               @default(0)
  /// Shipping weight in ounces. Null = default parcel weight from Settings.
  weightOz          Float?
  /// "coa_available" | "supplier_tested" | "pending" | "coming_soon"
  testingStatus     String            @default("coming_soon")
  coas              Coa[]
  purchases         Purchase[]
  adjustments       StockAdjustment[]
  orderLines        OrderLine[]

  @@index([listingId])
}

/// Certificate of analysis for one variant (batch).
model Coa {
  id        String    @id
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  file      String
  fileName  String    @default("")
  mime      String    @default("")
  lot       String    @default("")
  testDate  DateTime?
  purity    String    @default("")
  isCurrent Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([productId])
}

model Purchase {
  id             String   @id
  date           DateTime
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity       Int
  totalCostCents Int
  note           String   @default("")
  /// If true: adds stock and sets cost but does NOT subtract from business money.
  fromInvestment Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([productId])
}

model StockAdjustment {
  id        String   @id
  date      DateTime
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Positive or negative
  quantity  Int
  /// "breakage" | "freebie" | "correction"
  reason    String   @default("correction")
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([productId])
}

model Order {
  id               String          @id
  date             DateTime
  /// Snapshot of the customer name (kept in sync with the linked customer)
  customer         String          @default("")
  customerId       String?
  linkedCustomer   Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  /// Name of the payment method at the time of sale ("Unknown" for old orders)
  paymentMethod    String          @default("Unknown")
  note             String          @default("")
  /// "A" | "B" | "W" (website)
  soldBy           String          @default("A")
  /// "$" | "%"
  discountType     String          @default("$")
  /// Cents when discountType is "$", percent when "%"
  discountValue    Float           @default(0)
  tipCents         Int             @default(0)
  createdAt        DateTime        @default(now())
  /// Sequential order number starting at 1001
  number           Int?
  /// "inperson" | "online"
  source           String          @default("inperson")
  /// In-person: "completed". Online: "awaiting_payment" | "paid" | "label_purchased" | "shipped" | "delivered" | "canceled"
  status           String          @default("completed")
  archived         Boolean         @default(false)
  email            String          @default("")
  phone            String          @default("")
  /// JSON { name, street1, street2, city, state, zip, country }
  shipToJson       String          @default("")
  /// Shipping charged to the customer. Goes 100% to business money.
  shippingCents    Int             @default(0)
  /// What the customer picked, e.g. "USPS Ground Advantage" or "Flat rate"
  shippingMethod   String          @default("")
  /// JSON { carrier, service, cents } of the live rate picked at checkout
  shippingRateJson String          @default("")
  /// JSON { code, promotionIds, labels, freeShipping }
  promoJson        String          @default("")
  /// Payment method id the customer picked at checkout ("zelle", "cashapp", "venmo", ...)
  payChoice        String          @default("")
  /// Shipping tier id picked at checkout ("standard" | "priority" | "express")
  shippingTier     String          @default("")
  /// Secret link tokens
  token            String?
  reviewToken      String?
  /// Private upload (payment screenshot)
  screenshotFile   String          @default("")
  cancelReason     String          @default("")
  placedAt         DateTime?
  expiresAt        DateTime?
  paidAt           DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  canceledAt       DateTime?
  trackingNumber   String          @default("")
  trackingCarrier  String          @default("")
  trackingStatus   String          @default("")
  labelUrl         String          @default("")
  /// Internal note for the team. Never sent to or shown to the customer.
  adminNote        String          @default("")
  /// When the unpaid-order reminder email was sent (once per order)
  reminderSentAt   DateTime?
  /// Owner purchase at cost: "A" | "B" (which partner). Null = a normal sale.
  owner            String?
  /// Cash sales: who received the cash, "A" | "B". Null = not recorded.
  cashTo           String?
  /// Store credit used on this order (works like a discount). Taken from the balance only once the order counts.
  storeCreditCents Int             @default(0)
  /// Customer who referred this sale (earns referral credit once it counts). No relation on purpose.
  referredById     String?
  /// Referral code as typed / shown at the time of the order (kept even if the owner changes their code later).
  referralCode     String          @default("")
  /// Referrer reward percent at the time of the order. Null = no referral. Later Settings changes never touch it.
  referralRatePct  Float?
  /// Buyer referral discount percent at the time of the order (already inside discountValue).
  referralDiscountPct Float        @default(0)
  /// The buyer referral discount in cents (already inside discountValue; kept for display).
  referralDiscountCents Int        @default(0)
  /// Money given back to the customer after the order counted (partial or full refund). Lowers revenue.
  refundedCents    Int             @default(0)
  lines            OrderLine[]
  splitItems       SplitItem[]
  labels           LabelPurchase[]
  events           OrderEvent[]
  review           Review?

  @@unique([number])
  @@unique([token])
  @@unique([reviewToken])
  @@index([date])
  @@index([customerId])
  @@index([status])
}

/// An in-person order saved for later on the Sell screen. Not an order yet: it never touches stock or money.
/// Completing it creates a normal Order and removes this row.
model SavedOrder {
  id            String   @id
  customer      String   @default("")
  /// Linked customer, or a new id to create with the order when it is completed. No relation on purpose.
  customerId    String?
  paymentMethod String   @default("")
  note          String   @default("")
  /// "A" | "B"
  soldBy        String   @default("A")
  /// "$" | "%"
  discountType  String   @default("$")
  discountValue Float    @default(0)
  tipCents      Int      @default(0)
  /// JSON array of { id, productId, productName, quantity, unitPriceCents, unitCostCents, cutPercent, listPriceCents }
  linesJson     String   @default("[]")
  savedAt       DateTime @default(now())
  /// Owner purchase at cost: "A" | "B". Null = normal.
  owner         String?
  /// Cash: who will receive it, "A" | "B". Null = the seller.
  cashTo        String?
  /// Store credit picked for this order. Only taken from the balance when it is completed.
  storeCreditCents Int   @default(0)
  referredById  String?
}

model Customer {
  id        String   @id
  name      String
  phone     String   @default("")
  email     String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  /// Set when the customer has a website account
  passwordHash   String?
  /// JSON array of saved shipping addresses
  addressesJson  String    @default("[]")
  resetTokenHash String?
  resetExpiresAt DateTime?
  /// Invite / claim link (sha256 of the secret token). Single use; a new link replaces it.
  inviteTokenHash String?
  inviteExpiresAt DateTime?
  /// When the current (or last) invite link was made.
  inviteCreatedAt DateTime?
  /// When an invite link was used, and the email it was claimed with.
  inviteClaimedAt DateTime?
  inviteClaimedEmail String?
  /// Set by "Set temporary password": the customer must choose a new one at next sign in.
  mustChangePassword Boolean  @default(false)
  lastLoginAt    DateTime?
  /// Code this customer shares with friends, normalized UPPERCASE. Filled in for every customer.
  /// Unique across all referral codes AND discount codes (CodeClaim table, kept in sync by SQL triggers).
  referralCode   String?      @unique
  /// The code as the customer typed it (e.g. "Sarah-K"). Null = show referralCode.
  referralCodeDisplay String?
  /// Who referred this customer. No relation on purpose (a deleted referrer just unlinks).
  referredById   String?
  orders    Order[]
  credits   CreditEntry[]
  codeChanges ReferralCodeChange[]
}

/// Every code a customer can type: referral codes and discount codes share ONE namespace.
/// The primary key is the database-level uniqueness guarantee. Rows are written by SQL triggers on
/// Customer.referralCode and Promotion.code (see migration 20261123120000_referral_program), never by app code.
model CodeClaim {
  /// Normalized uppercase code
  code        String  @id
  /// "referral" | "promo"
  kind        String
  customerId  String?
  promotionId String?

  @@index([customerId])
  @@index([promotionId])
}

/// History of a customer's referral code changes (old code is freed immediately).
model ReferralCodeChange {
  id         String   @id
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  oldCode    String
  newCode    String
  /// "Customer" or the admin partner name
  by         String   @default("")
  at         DateTime @default(now())

  @@index([customerId])
}

/// Store credit history. The balance is the sum of amountCents; nothing stores a running balance.
model CreditEntry {
  id             String   @id
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  date           DateTime @default(now())
  /// Positive adds credit, negative uses or removes it.
  amountCents    Int
  /// "manual" | "order" (credit used on an order, or refunded) | "referral" (referrer reward) | "referral_new" (referred customer reward)
  kind           String
  reason         String   @default("")
  /// Related order (kept as history even if the order is deleted)
  orderId        String?
  orderNumber    Int?
  /// Who did it: a partner name, "Website", "Automatic"...
  by             String   @default("")
  /// Part of a reversal that could not be taken back because the balance would go below $0 (old rule, history only).
  shortfallCents Int      @default(0)
  /// Pending referral credit (order placed, not paid yet): visible but not spendable, not in the balance.
  pending        Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([customerId])
  @@index([orderId])
}

model OrderLine {
  id             String   @id
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String?
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  /// Snapshot of the product name so history survives product deletion
  productName    String   @default("")
  quantity       Int
  unitPriceCents Int
  unitCostCents  Int
  cutPercent     Float
  sortOrder      Int      @default(0)
  /// Set when a BOGO deal discounted this line: the deal (Promotion id) and its name at the time
  dealId         String   @default("")
  dealName       String   @default("")
  /// Price each before a BOGO deal or owner price. Null = no special price.
  fullPriceCents Int?

  @@index([orderId])
}

/// A shipping label bought for an order. Its cost comes out of business money.
model LabelPurchase {
  id                  String   @id
  orderId             String?
  order               Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  date                DateTime
  costCents           Int
  carrier             String   @default("")
  service             String   @default("")
  trackingNumber      String   @default("")
  labelUrl            String   @default("")
  shippoTransactionId String   @default("")
  voided              Boolean  @default(false)
  createdAt           DateTime @default(now())

  @@index([orderId])
}

/// Timeline of an order: status changes, emails sent, notes.
model OrderEvent {
  id      String   @id
  orderId String
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  at      DateTime @default(now())
  /// "status" | "email" | "note"
  kind    String   @default("status")
  message String
  detail  String   @default("")

  @@index([orderId])
}

model Promotion {
  id               String         @id
  /// "code" | "auto" | "free_shipping" | "bogo"
  kind             String
  name             String         @default("")
  /// Uppercase, only for kind "code"
  code             String         @default("")
  /// "$" | "%"
  discountType     String         @default("$")
  /// Cents when "$", percent when "%"
  discountValue    Float          @default(0)
  minSubtotalCents Int            @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  maxUses          Int?
  oncePerEmail     Boolean        @default(false)
  /// JSON arrays. Empty = applies to everything.
  listingIdsJson   String         @default("[]")
  groupIdsJson     String         @default("[]")
  /// Free shipping rules only: JSON array of the shipping option ids it makes free ("standard" | "priority" | "express"). At least one.
  shippingTiersJson String        @default("[]")
  /// BOGO deals only (kind "bogo"): JSON { buy, get, online, inPerson, noCodes }. See src/lib/bogo.ts
  bogoJson         String         @default("")
  active           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  uses             PromotionUse[]
}

/// One use of a promotion by an order. Removed when the order is canceled.
model PromotionUse {
  id          String    @id
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  orderId     String?
  email       String    @default("")
  createdAt   DateTime  @default(now())

  @@index([promotionId])
  @@index([orderId])
}

/// Store experience review left through the secret link in the delivered email.
model Review {
  id          String   @id
  orderId     String?  @unique
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  rating      Int
  text        String   @default("")
  displayName String   @default("")
  /// "pending" | "approved" | "hidden"
  status      String   @default("pending")
  edited      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id          String   @id
  name        String
  email       String
  orderNumber String   @default("")
  message     String
  handled     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

/// Built-in analytics: one counter per day, metric and key. Aggregate counts only, nothing about a person.
/// metric: "visit" | "product_view" | "add_to_cart" | "checkout_start" | "order". key: listing id for product metrics, "" otherwise.
model AnalyticsDay {
  /// Local calendar day, "YYYY-MM-DD"
  day    String
  metric String
  key    String @default("")
  count  Int    @default(0)

  @@id([day, metric, key])
  @@index([day])
}

/// One-time data fixes that run at server start (after the SQL migrations). A row here means it already
/// ran, so it never runs again (e.g. a size the owner later clears is never filled back in).
model DataMigration {
  id     String   @id
  ranAt  DateTime @default(now())
  /// JSON: what it changed, for the record
  detail String   @default("")
}

/// Cash moved between the partners and the bank ("A" | "B" | "bank"). Business money stays the same.
model CashHandoff {
  id          String   @id
  date        DateTime
  fromHolder  String
  toHolder    String
  amountCents Int
  note        String   @default("")
  createdAt   DateTime @default(now())
}

model Split {
  id            String      @id
  date          DateTime
  note          String      @default("")
  partnerACents Int
  partnerBCents Int
  businessCents Int
  createdAt     DateTime    @default(now())
  items         SplitItem[]
  payouts       Payout[]
}

/// What a split covered for one order (lines + tip), as amounts at split time.
/// orderId becomes null if the order is later deleted (the amount stays as history).
model SplitItem {
  id            String  @id
  splitId       String
  split         Split   @relation(fields: [splitId], references: [id], onDelete: Cascade)
  orderId       String?
  order         Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  partnerACents Int
  partnerBCents Int
  businessCents Int

  @@index([splitId])
  @@index([orderId])
}

model Payout {
  id          String   @id
  date        DateTime
  /// "A" | "B"
  person      String
  amountCents Int
  note        String   @default("")
  /// Set when auto-created by a split. Those do not touch business money again.
  splitId     String?
  split       Split?   @relation(fields: [splitId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}
