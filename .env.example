# SQLite database file. Relative paths are resolved from the prisma/ folder, so this is <project>/data/peps.db. On Railway use file:/data/peps.db (Volume mounted at /data).
DATABASE_URL="file:../data/peps.db"
# Login password used until you change it in Settings (after that the hashed password in the database is used). CHANGE THIS in production.
APP_PASSWORD="peps1234"
# Random string (32+ chars) that signs the login cookie. This default only works locally; the app refuses to start in production with it.
SESSION_SECRET="local-dev-only-secret-change-me-in-production-0000"
