# SQLite database file. Relative paths are resolved from the prisma/ folder, so this is <project>/data/peps.db. On Railway use file:/data/peps.db (Volume mounted at /data).
DATABASE_URL="file:../data/peps.db"
# Admin login password used until you change it in Settings (after that the hashed password in the database is used). CHANGE THIS in production.
APP_PASSWORD="peps1234"
# Random string (32+ chars) that signs the login cookies. This default only works locally; the app refuses to start in production with it.
SESSION_SECRET="local-dev-only-secret-change-me-in-production-0000"

# --- Store (optional: the app runs without them and shows a clear warning in Settings) ---
# Resend API key for order emails. Get one at https://resend.com/api-keys
RESEND_API_KEY=""
# Shippo API token for live shipping rates and labels. A token starting with shippo_test_ buys free sample labels.
SHIPPO_API_KEY=""
# Optional. Public address of the site, used for links in emails when "Website address" in Settings is empty. Example: https://buckshotpeps.com
PUBLIC_URL=""
# Optional. Secret in the Shippo tracking webhook address. Left empty, one is derived from SESSION_SECRET (shown in Settings, Shipping).
SHIPPO_WEBHOOK_SECRET=""
# Optional. Folder for uploads and backups. Default: the folder of the database file (/data on Railway).
# DATA_DIR="/data"
