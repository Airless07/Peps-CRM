# PostgreSQL connection string (Railway Postgres provides this; locally e.g. postgresql://user:pass@localhost:5432/peps)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/peps_crm"
# Login password used until you change it in Settings (after that the hashed DB password is used)
APP_PASSWORD="change-me"
# Long random string used to sign the session cookie (e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"
